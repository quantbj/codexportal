          "$comment": "EVI: C2Zahlungsfluss.Contract"
        },
        "settlement_order_number": {
          "type": "string",
          "description": "Bestellnummer / Order Number",
          "$comment": "EVI: C2OrderNo.Contract"
        },
        "settlement_market_premium": {
          "type": "boolean",
          "description": "Abrechnung mit Marktprämie / Billing with Market Premium",
          "$comment": "EVI: C2AbrechMP.Contract"
        },
        "settlement_group": {
          "type": "string",
          "description": "Abrechnungsgruppe / Billing Group",
          "$comment": "EVI: C2AbrGrpPk.Contract"
        },
        "bank_account_iban": {
          "type": "string",
          "pattern": "tbd",
          "description": "IBAN / IBAN",
          "$comment": "EVI: IBAN.BankAccount"
        },
        "bank_account_holder": {
          "type": "string",
          "description": "Kontoinhaber / Account Holder",
          "$comment": "EVI: AccOwner.BankAccount"
        },
        "bank_account_bic": {
          "type": "string",
          "pattern": "tbd",
          "description": "BIC / BIC",
          "$comment": "EVI: BICKey.BankAccount"
        },
        "termination_period": {
          "type": "integer",
          "description": "Kündigungsfrist in Monaten / Termination Period in months",
          "$comment": "EVI: TerminationPeriod.Contract"
        },
        "remit_obligation": {
          "type": "string",
          "description": "REMIT-Pflicht / REMIT Obligation",
          "$comment": "EVI: C2REMITPflicht.Contract"
        },
        "remit_mirror_reporting": {
          "type": "string",
          "description": "REMIT-Spiegelmeldung / REMIT Mirror Reporting",
          "$comment": "EVI: C2REMITSpiegel.Contract"
        },
        "bank_guarantee": {
          "type": "string",
          "enum": [
            "rating-dependent",
            "general"
          ],
