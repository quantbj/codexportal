        },
        "bank_guarantee_until": {
          "type": "string",
          "format": "date",
          "description": "Bankbürgschaft bis / Bank Guarantee Until",
          "$comment": "EVI: C2BBuergBis.Contract"
        },
        "signatory_enbw_1": {
          "type": "string",
          "description": "Unterzeichner 1 EnBW / Signatory 1 EnBW",
          "$comment": "EVI: C2UntEnBW1.Contract"
        },
        "signatory_enbw_2": {
          "type": "string",
          "description": "Unterzeichner 2 EnBW / Signatory 2 EnBW",
          "$comment": "EVI: C2UntEnBW2.Contract"
        },
        "signatory_partner_1": {
          "type": "string",
          "description": "Unterzeichner 1 Vertragspartner / Signatory 1 Contract Partner",
          "$comment": "EVI: C2UntVP1.Contract"
        },
        "signatory_partner_2": {
          "type": "string",
          "description": "Unterzeichner 2 Vertragspartner / Signatory 2 Contract Partner",
          "$comment": "EVI: C2UntVPAP2.Contract"
        },
        "signature_customer_date": {
          "type": "string",
          "format": "date",
          "description": "Unterzeichnung Geschäftspartner / Customer Signature Date",
          "$comment": "EVI: SignatureCust.Contract"
        },
        "contract_conclusion_date": {
          "type": "string",
          "format": "date",
          "description": "Vertragsabschluss / Contract Conclusion Date",
          "$comment": "EVI: ContStartDate.Contract"
        },
        "country": {
          "type": "string",
          "description": "Land / Country",
          "$comment": "EVI: C2Country.Contract"
        },
        "rd_billing_model": {
          "type": "string",
          "description": "RD Abrechnungsmodell / RD Billing Model",
          "$comment": "EVI: RDAbrModell.C2RD_CONTRACT"
        },
        "rd_call_procedure": {
          "type": "string",
          "description": "RD Abrufverfahren / RD Call Procedure",
          "$comment": "EVI: RDAbrufVerf.C2RD_CONTRACT"
        },
        "rd_balancing_model": {
          "type": "string",
          "description": "RD Bilanzierungsmodell / RD Balancing Model",
          "$comment": "EVI: RDBilModell.C2RD_CONTRACT"
        },
        "rd_operator_btr": {
          "type": "string",
          "description": "RD Betreiber BTR / RD Operator BTR",
          "$comment": "EVI: RDBetrBTRRef.C2RD_CONTRACT"
        },
        "rd_deployment_responsible_eiv": {
          "type": "string",
          "description": "RD Einsatzverantwortlicher EIV / RD Deployment Responsible EIV",
          "$comment": "EVI: RDEvEIVRef.C2RD_CONTRACT"
        },
        "rd_email_address": {
          "type": "string",
          "description": "Email-Adresse für Redispatch / Email Address for Redispatch ",
          "$comment": "EVI: RDMail.C2RD_CONTRACT"
        }
      }
    },
    "counterparty": {
      "type": "object",
      "required": [
        "company_name",
        "person_type",
        "language",
        "acer_code",
        "trade_register_number",
        "trade_register_court"
      ],
      "anyOf": [
        {
          "required": [
            "vat_id"
          ]
        },
        {
          "required": [
            "tax_number"
          ]
        }
      ],
      "properties": {
        "company_name": {
          "type": "string",
          "description": "Firma / Company Name",
          "$comment": "EVI: Name1.Customer"
        },
        "person_type": {
          "type": "string",
          "description": "Typ / Person Type",
          "$comment": "EVI: PersontypeKey.Customer"
        },
        "language": {
          "type": "string",
          "enum": [
            "DE",
            "EN",
            "FR"
          ],
          "description": "Sprache / Language",
          "$comment": "EVI: LanguageKey.Person"
        },
        "acer_code": {
          "type": "string",
          "description": "ACER-Code / ACER Code",
          "$comment": "EVI: C2ACER.Customer"
        },
        "reverse_charge": {
          "type": "string",
          "description": "Reverse Charge / Reverse Charge",
          "$comment": "EVI: C2ReversCharge.Customer"
        },
        "ar_partner_type": {
          "type": "string",
          "enum": [
            "CONSUMER",
            "VERB_ORG",
            "VERB_RC",
            "VERB_UST",
            "WV_RC"
          ],
          "description": "AR GP Typ / AR Partner Type",
          "$comment": "EVI: C12ISU_TYPE.Customer"
        },
        "lei": {
          "type": "string",
          "description": "Reale LEI / Legal Entity Identifier",
          "$comment": "EVI: C2LEI.Customer"
        },
        "vat_id": {
          "type": "string",
          "description": "Umsatzsteuer-ID / W-IN / VAT ID",
          "$comment": "EVI: VATIDNo.Person"
        },
        "tax_number": {
          "type": "string",
          "description": "Steuer-Nr. / Tax Number",
          "$comment": "EVI: Wagetaxno.Person"
        },
        "trade_register_number": {
          "type": "string",
          "description": "Handelsregister Nr. / Trade Register Number",
          "$comment": "EVI: TradeRegister.Person"
        },
        "trade_register_court": {
          "type": "string",
          "description": "Registergericht / Trade Register Court",
          "$comment": "EVI: TradeRegisterCity.Person"
        },
        "address": {
          "$ref": "#/$defs/address"
        },
        "communication": {
          "$ref": "#/$defs/communication"
        }
      }
    },
    "contact_persons": {
      "type": "array",
      "description": "Weitere Ansprechpartner des Kunden / Further contact persons of the customer",
      "items": {
        "type": "object",
        "required": [
          "last_name",
          "language",
          "type"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "C",
              "M",
              "F",
              "D"
            ],
            "description": "Typ / Type",
            "$comment": "EVI: Sex.ContactPerson"
          },
          "language": {
            "type": "string",
            "description": "Sprache / Language",
            "$comment": "EVI: LanguageKey.ContactPerson"
          },
          "last_name": {
            "type": "string",
            "description": "Nachname/Firma / Last Name/Company",
            "$comment": "EVI: LastName.ContactPerson"
          },
          "first_name": {
            "type": "string",
            "description": "Vorname/Zusatz1 / First Name/Addition 1",
            "$comment": "EVI: FirstName.ContactPerson"
          },
          "name_addition": {
            "type": "string",
            "description": "Zusatz/Zusatz2 / Addition/Addition 2",
            "$comment": "EVI: Name3.ContactPerson"
          },
          "email": {
            "type": "string",
            "format": "email",
            "description": "E-Mail / Email",
            "$comment": "EVI: Email.ContactPerson"
          },
          "phone_country_code": {
            "type": "string",
            "description": "Telefon Ländervorwahl / Phone Country Code",
            "$comment": "EVI: PhoneNoCountry.ContactPerson"
          },
          "phone_area_code": {
            "type": "string",
            "description": "Telefon Ortsvorwahl / Phone Area Code",
            "$comment": "EVI: PhoneNoCity.ContactPerson"
          },
          "phone_base_number": {
            "type": "string",
            "description": "Telefon Rufnummer / Phone Base Number",
            "$comment": "EVI: PhoneNoBase.ContactPerson"
          },
          "phone_extension": {
            "type": "string",
            "description": "Telefon Durchwahl / Phone Extension",
            "$comment": "EVI: PhoneNoExtension.ContactPerson"
          },
          "contract_role": {
            "type": "string",
            "enum": [
              "commercial_operator",
              "portfolio_manager",
              "technical_operator",
              "contract_partner"
            ],
            "$comment": "Optionale Vertragsrollen für Zugriff auf den Vertrag im ITC-Portal"
          }
        }
      },
      "minItems": 0,
      "$comment": "Optional contact persons for the counterparty"
    },
    "park": {
      "type": "object",
      "required": [
        "park_name",
        "control_area"
      ],
      "properties": {
        "park_name": {
          "type": "string",
          "description": "Regelzone / Control Area",
          "$comment": "EVI: LOCATION.C2REGELZONE"
        },
        "control_area": {
          "type": "string",
          "description": "Regelzone / Control Area",
          "$comment": "EVI: LOCATION.C2REGELZONE"
        },
        "cumulative_inverter_capacity": {
          "type": "number",
          "description": "Kumulierte Leistung der Wechselrichter / Cumulative Inverter Capacity",
          "$comment": "EVI: C2MaxEinspLst.Location"
        },
        "unavailability_reporting_level": {
          "type": "string",
          "description": "Ebene Nichtverfügbarkeits-Meldung / Unavailability Reporting Level",
          "$comment": "EVI: C2NVMELDUNG.Location"
        }
      }
    },
    "metering_points": {
      "type": "array",
      "description": "Messzählpunkte / Metering Points",
      "items": {
        "$ref": "#/$defs/metering_point"
      },
      "minItems": 1,
      "$comment": "Mindestens ein MZP erforderlich"
    }
  }
}
