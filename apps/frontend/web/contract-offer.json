            "type": "string",
            "format": "email"
          },
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "description": "E-Mail-Adressen für Gutschriften (1-3) / Settlement Email Addresses (1-3)",
          "$comment": "EVI: C2EmailGutschr.Contract, C2EmailGutschr2.Contract, C2EmailGutschr3.Contract"
        },
        "alternative_invoice_address": {
          "type": "string",
          "description": "Abweichende Rechnungsadresse / Alternative Invoice Address",
          "$comment": "EVI: C2AbwRech.Contract"
        },
        "settlement_due_day": {
          "type": "integer",
          "description": "Kalendertag des Vormonats - Fälligkeitstag / Due Day",
          "$comment": "EVI: C2FealligTag.Contract"
        },
        "settlement_interval_supplier": {
          "type": "integer",
          "enum": [
            1,
            3,
            6,
            12
          ],
          "description": "Abrechnungsintervall Lieferant in Monaten / Billing Interval Supplier in Months",
          "$comment": "EVI: C2AbrIntLief.Contract"
        },
        "settlement_payment_flow": {
          "type": "string",
          "enum": [
            "G",
            "R"
          ],
