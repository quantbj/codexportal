          "$comment": "EVI: C2DelivStart.Contract"
        },
        "contract_end": {
          "type": "string",
          "format": "date",
          "description": "Lieferende / Delivery End",
          "$comment": "EVI: ContEndDate.Contract"
        },
        "contract_type": {
          "type": "string",
          "description": "Vertragstyp / Contract Type",
          "$comment": "EVI: C2Kundentyp.Contract"
        },
        "extension_clause": {
          "type": "boolean",
          "description": "Automatische Verlängerungsklausel / Automatic Extension Clause",
          "$comment": "EVI: C2VerlKlausel.Contract"
        },
        "extension_period": {
          "type": "integer",
          "description": "Verlängerung um x Monate / Extension Period by x months",
          "$comment": "EVI: ExtensionPeriod.Contract"
        },
        "curtailment_notification": {
          "type": "string",
